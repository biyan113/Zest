        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在所有网络接口上监听 TCP %lld 端口，同一网络中的设备可以连接。"
          }
        }
      }
    },
    "%@ 连接到 %@。端口 %lld 常见于远程控制或恶意软件。" : {
