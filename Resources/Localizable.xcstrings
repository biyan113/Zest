{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%1$@ · %2$@" : {
      "comment" : "已忽略规则：告警标题与应用名。%1$@ 为标题，%2$@ 为应用名。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%1$@ 最近 30 秒平均上传 %2$@，是此前基线（%3$@）的 %4$lld× 以上。" : {
      "comment" : "上传流量突增的告警详情，出现在告警列表和通知正文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ averaged %2$@ uploaded over the last 30 seconds, more than %4$lld× its previous baseline (%3$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 最近 30 秒平均上传 %2$@，是此前基线（%3$@）的 %4$lld× 以上。"
          }
        }
      }
    },
    "%1$@ 约每 %2$.0f 秒新建一次到 %3$@ 的连接（共 %4$lld 次），节奏非常规律，可能是心跳或信标。" : {
      "comment" : "周期性外连的告警详情，出现在告警列表和通知正文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ opens a new connection to %3$@ about every %2$.0f seconds (%4$lld times). The timing is very regular and may be a heartbeat or beacon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 约每 %2$.0f 秒新建一次到 %3$@ 的连接（共 %4$lld 次），节奏非常规律，可能是心跳或信标。"
          }
        }
      }
    },
    "%1$@ 通过未加密的 %2$@ 连接 %3$@，内容可能被他人读取。" : {
      "comment" : "明文协议连接的告警详情，出现在告警列表和通知正文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ connected to %3$@ over unencrypted %2$@. The contents may be readable by others."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 通过未加密的 %2$@ 连接 %3$@，内容可能被他人读取。"
          }
        }
      }
    },
    "%@ · %@ · 已运行 %@" : {
      "comment" : "面板顶栏副标题：机型、内存大小、已运行时长",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · Up %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · 已运行 %@"
          }
        }
      }
    },
    "%@ 在 1 分钟内连接了本机 %lld 个不同端口。" : {
      "comment" : "疑似端口扫描的告警详情，出现在告警列表和通知正文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ connected to %lld different ports on this Mac within 1 minute."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 1 分钟内连接了本机 %lld 个不同端口。"
          }
        }
      }
    },
    "%@ 在所有网络接口上监听 TCP %lld 端口，同一网络中的设备可以连接。" : {
      "comment" : "对外开放端口的告警详情，出现在告警列表和通知正文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is listening on TCP port %lld on all network interfaces. Devices on the same network can connect."
